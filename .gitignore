# Private configuration and secrets
.env
.env.*
!.env.example

# Personal AI extraction guidelines - may contain personal context/preferences
template.md

# Telethon's locally stored authorization sessions
*.session
*.session-journal

# Local SQLite database - contains real Telegram message content
# (whole directory, since SQLite's WAL mode adds -wal/-shm files alongside the .db)
data/

# Local Python environment and generated files
.venv/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/

# macOS Finder metadata
.DS_Store

# launchd job output
logs/
